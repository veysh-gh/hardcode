{
  "name": "hardcode",
  "version": "0.1.0",
  "private": true,
  "description": "A developer-first, agentic code editor",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite\" \"wait-on tcp:5173 && node electron/launch.mjs\"",
    "build": "vite build",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "latest",
    "@codemirror/lang-vue": "^0.1.3",
    "@earendil-works/pi-coding-agent": "latest",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "codemirror": "latest",
    "diff": "^9.0.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "latest",
    "electron": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
